.DS_Store
.certs/
node_modules/
.venv/
*.pptx
shots/
*.jsonl
# ...except the tuning corpus. It is the regression suite for every future
# lexicon change: without it the before/after numbers cannot be reproduced and
# the next person is back to guessing. Synthetic throughout, so nothing to
# protect.
!tools/tuning/**/*.jsonl

# Screens by perspective: a few dozen images, regenerated on demand and stale
# the moment a view changes. The six PDFs in docs/ are committed; these are not.
docs/screens/

# Machine-local tool permissions. .claude/settings.json is shared; this is not.
.claude/settings.local.json

# Pages sources. Dave keeps the raw documents he authored next to the PDFs they
# produced, for his own filing. They are his working files, not repository
# artifacts: nothing here opens, rebuilds or tests them, and the PDF beside each
# one is the thing that ships. Excluded from the docs/ count in
# tests/unit/docs.test.mjs for the same reason.
*.pages
