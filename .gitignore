.DS_Store
.certs/
node_modules/
.venv/
*.pptx
shots/
*.jsonl
# ...except the tuning corpus. It is the regression suite for every future
# lexicon change: without it the before/after numbers cannot be reproduced and
# the next person is back to guessing. Synthetic throughout, so nothing to
# protect.
!tools/tuning/**/*.jsonl

# Screens by perspective: a few dozen images, regenerated on demand and stale
# the moment a view changes. The five PDFs in docs/ are committed; these are not.
docs/screens/

# Machine-local tool permissions. .claude/settings.json is shared; this is not.
.claude/settings.local.json
